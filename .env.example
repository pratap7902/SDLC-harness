APP_ENV=local
SENTRY_DSN=

# Database: DATABASE_URL wins. Unset → MySQL from DB_MYSQL_* when DB_MYSQL_HOST is set,
# else the SQLite file var/dev.db.
# DATABASE_URL=sqlite+pysqlite:///./var/dev.db
# DB_MYSQL_HOST=127.0.0.1
# DB_MYSQL_PORT=3311
# DB_MYSQL_USER=root
# DB_MYSQL_PASSWORD=srs
# DB_MYSQL_DB=srs

# Auth: unset → header under APP_ENV=local/testing (X-Actor + X-Actor-Kind), else token
# (Authorization: Bearer, `make token`). Header mode is refused outside local/testing.
# AUTH_MODE=token
# Cloudflare Access in front of the web UI (production): see docs/integrations.md
# CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
# CF_ACCESS_AUD=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
REVIEW_PROPAGATION=true
LEASE_DEFAULT_TTL_MIN=15

# ── integrations (docs/integrations.md). Placeholders only; never commit real values. ──
# PUBLIC_BASE_URL=https://srs.example.com
# Microsoft Teams
# TEAMS_TENANT_ID=00000000-0000-0000-0000-000000000000
# TEAMS_GRAPH_CLIENT_ID=
# TEAMS_GRAPH_CLIENT_SECRET=
# TEAMS_BOT_APP_ID=
# TEAMS_BOT_APP_SECRET=
# Outline knowledge base
# OUTLINE_URL=https://wiki.example.com
# OUTLINE_API_KEY=
# OUTLINE_CF_ACCESS_CLIENT_ID=
# OUTLINE_CF_ACCESS_CLIENT_SECRET=
# Azure DevOps Boards
# ADO_ORG=your-org
# ADO_PROJECT=your-project
# ADO_PAT=
# ADO_WEBHOOK_SECRET=
# ADO_ENGG_FIELD=
