APP_ENV=local
SENTRY_DSN=

# Database: DATABASE_URL wins. Unset → MySQL from DB_MYSQL_* when DB_MYSQL_HOST is set,
# else the SQLite file var/dev.db.
# DATABASE_URL=sqlite+pysqlite:///./var/dev.db
# DB_MYSQL_HOST=127.0.0.1
# DB_MYSQL_PORT=3311
# DB_MYSQL_USER=root
# DB_MYSQL_PASSWORD=srs
# DB_MYSQL_DB=srs

# header (dev, tests): X-Actor + X-Actor-Kind. token: deferred.
AUTH_MODE=header
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
REVIEW_PROPAGATION=true
LEASE_DEFAULT_TTL_MIN=15

# GitHub mode only — webhooks (POST /hooks/github): the App's webhook secret. Empty → 503.
# GITHUB_WEBHOOK_SECRET=

# ── the runner (runner/, deployed separately; see docs/runner.md) ──────────
# WORKSPACE_MODE=local            # default: repos are local paths (registry `local_path`),
#                                 # cloned into a sandbox, never pushed; no GitHub needed.
#                                 # `github` = optional GitHub App backend (below).
# RUNNER_WORK_ROOT=/var/harness   # job worktrees + per-repo sandboxes
# SRS_URL=http://localhost:8791
# SRS_TOKEN=                      # an agent token: make token ACTOR=runner-sdk KIND=agent
# Claude auth: ANTHROPIC_API_KEY, or a documented provider (CLAUDE_CODE_USE_BEDROCK=1,
# CLAUDE_CODE_USE_VERTEX=1, CLAUDE_CODE_USE_FOUNDRY=1, or CLAUDE_CODE_USE_ANTHROPIC_AWS=1 +
# ANTHROPIC_AWS_WORKSPACE_ID) with that cloud's credentials. Never a claude.ai login or
# subscription — not permitted for products built on the Agent SDK.
# ANTHROPIC_API_KEY=
# CLAUDE_CLI_PATH=                # optional; unset = the CLI bundled with claude-agent-sdk
# RUNNER_MODEL=claude-opus-5-5
# GitHub mode only (WORKSPACE_MODE=github):
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_PRIVATE_KEY_PATH=
